# =====================================================================
# program-platform — Environment Configuration
# =====================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`
# to source control (it's listed in .gitignore).
# =====================================================================

# ---- Server ----
# Public-facing origin of the deployment. Used in links / metadata.
APP_BASE_URL=http://localhost:3000

# Port the Next.js server listens on. Defaults to 3000.
PORT=3000

# ---- Base path (sub-directory deployment) ----
# If the app is deployed under a sub-path (e.g. https://edfutures.ycyw.com/Marketing/),
# set BASE_PATH to that sub-path. Leave empty for root deployment.
#   - Set ONLY at BUILD time. Read by next.config.mjs.
#   - Must start with "/" (e.g. /Marketing, not Marketing)
#   - Must NOT end with "/" (e.g. /Marketing, not /Marketing/)
#   - Must contain only URL-safe characters ([a-zA-Z0-9_-]).
#     The regex /^\/[a-zA-Z0-9_-]+$/ is enforced at startup
#     (src/lib/config.js and src/lib/basePath.js). A bad value
#     will crash the server rather than silently leaking paths.
#   - NEXT_PUBLIC_BASE_PATH must be set to the SAME value (used by
#     the @font-face CSS variable; NEXT_PUBLIC_* vars are inlined
#     at build time).
# Examples:
#   Root deployment:     BASE_PATH=
#   Sub-path deployment: BASE_PATH=/Marketing
BASE_PATH=
NEXT_PUBLIC_BASE_PATH=

# ---- Database ----
# Path to the SQLite file. IMPORTANT: place this OUTSIDE the build
# output directory (i.e. NOT inside .next/ or dist/). The default
# `../data/dev.db` resolves to `./data/dev.db` relative to the project
# root (Prisma resolves SQLite paths relative to the schema file).
#
# In production, use an absolute path: file:/var/data/ycyw/db.sqlite
DATABASE_URL="file:../data/dev.db"

# ---- File storage ----
# Directory where uploaded programme files (videos, photos, articles,
# resources, cover images) are stored. MUST be outside the build output
# directory. On the production server this should be a persistent path
# (e.g. /var/data/ycyw/uploads) that survives redeployments.
UPLOAD_DIR="./data/uploads"

# Max upload size in megabytes. Default 500 MB.
MAX_UPLOAD_MB=500

# ---- Auth ----
# Two bearer tokens. Marketing team uses VIEW_TOKEN, admin uses
# ADMIN_TOKEN. Both set an httpOnly cookie with the role.
#
# Generate with:   openssl rand -hex 32

ADMIN_TOKEN="replace-with-64-char-random-hex"
VIEW_TOKEN="replace-with-different-64-char-random-hex"

# ---- Cookie name (advanced) ----
# The cookie used to remember the user's role. Defaults to "pp_role".
# You only need to change this if it collides with another app.
ROLE_COOKIE_NAME="pp_role"

# ---- Cookie signing secret ----
# HMAC-SHA256 key used to sign the role cookie (see AUDIT-REPORT.md C-1).
# A plain "admin" cookie is rejected by the middleware, so any cookie
# it issues must be verifiable with this secret. REQUIRED in production.
# Generate with:  openssl rand -hex 32
# (In development a missing value is allowed but signing will fail at
# the first /api/auth/login request, so set it even for local dev.)
COOKIE_SECRET="replace-with-64-char-random-hex"

# ---- Optional: one-off Notion migration ----
# Only used by `npm run db:seed:notion`. Not used by the running app.
# NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
