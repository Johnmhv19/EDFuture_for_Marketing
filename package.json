{
  "name": "program-platform",
  "version": "0.1.0",
  "private": true,
  "description": "YCYW Advanced Pathways Academy — programmes for marketing. Read-only marketing view + admin upload/edit.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "node prisma/seed.mjs",
    "db:seed:notion": "node prisma/seed-from-notion.mjs",
    "db:seed:notion-data": "node prisma/seed-from-notion-data.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15"
  }
}
