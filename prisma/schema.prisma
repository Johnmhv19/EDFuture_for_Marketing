// =====================================================================
// program-platform — Prisma schema (SQLite)
// =====================================================================
// Database for the YCYW Advanced Pathways Academy programme platform.
// Replaces the previous Notion implementation. Local-first, SQLite,
// single-process. See README.md and DEPLOY.md for the full picture.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---- Enum-equivalent string fields ----
// SQLite + Prisma does not support native enums, so we use string
// columns and enforce valid values at the application layer.
// See src/lib/labels.js for the canonical lists and LABELS map.

// Level:        L1 | L2 | L3 | L2_AND_L3 | WHOLE_SCHOOL
// Pathway:      WHOLE_SCHOOL | ROBOTICS_ENGINEERING | BUSINESS_LAW |
//               CREATIVE_EXPERIENCE | HEALTH_MEDICINE | SCIENCE_RESEARCH |
//               COMPUTER_SCIENCE_DATA_SCIENCE
// FileCategory: VIDEO | PHOTO | ARTICLE | RESOURCE | COVER_IMAGE
// FileStatus:   ACTIVE | ARCHIVED
// Status:       Confirmed | Planned | TBD | In development
// (Status is free-text; the marketing team uses these specific values
// but the column is a string so admins can add new statuses without
// a migration.)

// ---- Models ----

model Programme {
  id           String   @id @default(cuid())
  name         String   @unique
  // Level — one of LevelOrder
  level        String
  // Pathway — one of PathwayOrder
  pathway      String
  yearLevel    String?
  partners     String?
  venue        String?
  // Free-text dates (e.g. "Term 1 2027", "Sep–Jul"). Preserved for
  // legacy display. The structured startDate / endDate below are the
  // source of truth for "Coming up" / "Recent past" home-page
  // sections. Either may be null (programme has no scheduled date
  // yet — "TBD"). See AUDIT-REPORT.md / new feature work 2026-09-03.
  dates        String?
  // Structured event dates. Either both null (TBD) or at least
  // startDate set. If both are set, endDate >= startDate is enforced
  // at the app layer.
  startDate    DateTime?
  endDate      DateTime?
  status       String   @default("Confirmed")
  description  String?
  // Ordering
  sortOrder    Int      @default(0)
  // Audit
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  files        ProgrammeFile[]

  @@index([level])
  @@index([pathway])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model ProgrammeFile {
  id           String       @id @default(cuid())
  programmeId  String
  programme    Programme    @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  // FileCategory: VIDEO | PHOTO | ARTICLE | RESOURCE | COVER_IMAGE
  category     String
  // FileType:    UPLOAD | LINK | FOLDER
  //   UPLOAD = file on disk (storageKey set)
  //   LINK   = external URL to a single resource (storageKey null, url set)
  //   FOLDER = external URL to a folder of resources (storageKey null, url set)
  type         String       @default("UPLOAD")
  // FileStatus
  status       String       @default("ACTIVE")
  // Display name (defaults to original filename or URL)
  displayName  String
  // For UPLOAD: original filename. Null for LINK/FOLDER.
  originalName String?
  // For UPLOAD: path on disk, relative to UPLOAD_DIR. Null for LINK/FOLDER.
  storageKey   String?      @unique
  // For LINK / FOLDER: the external URL. Null for UPLOAD.
  url          String?
  // For UPLOAD: mime type and size. Null for LINK/FOLDER.
  mimeType     String?
  sizeBytes    Int?
  // Optional caption / description
  caption      String?
  // Whether non-admin viewers can fetch this file via /api/files/[id].
  // COVER_IMAGE defaults to false; everything else defaults to true.
  // See AUDIT-REPORT.md M-2.
  isPublic     Boolean      @default(false)
  // Role of the uploader: 'admin' or 'viewer'. Used to gate delete
  // permission — viewers can only delete files they themselves
  // uploaded; admins can delete any file. Defaults to 'admin' so
  // existing rows from before this field was added are not suddenly
  // undeletable by viewers.
  uploadedByRole String     @default("admin")
  // Audit
  uploadedAt   DateTime     @default(now())
  uploadedBy   String?

  @@index([programmeId, category])
  @@index([type])
  @@index([status])
}
